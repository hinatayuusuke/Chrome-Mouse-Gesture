{
  "manifest_version": 3,
  "name": "GestureMaster",
  "version": "0.1.0",
  "description": "マウスジェスチャーとスーパードラッグでタブ操作を行います。",
  "permissions": ["tabs", "sessions", "activeTab", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GestureMaster"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
