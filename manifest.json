{
  "manifest_version": 3,
  "name": "GestureMaster",
  "version": "0.2.0",
  "description": "マウスジェスチャーとスーパードラッグでタブ操作を行います。",
  "permissions": ["sessions", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "i18n.js",
        "content/constants.js",
        "content/state.js",
        "content/utils.js",
        "content/overlay.js",
        "content/actions.js",
        "content/gestures.js",
        "content/config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {    
    "default_title": "GestureMaster"
  },
  "commands": {
    "open-options": {
      "description": "Open GestureMaster options"
    }
  },
  
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "images/MG16.png",
    "48": "images/MG48.png",
    "128": "images/MG128.png"
  }
}
